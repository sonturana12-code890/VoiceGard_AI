# VOICEGUARD AI — Production Environment Configuration
# Problem Statement: SIH26104 — AI Voice Anti-Spoofing & Cyber Acoustic Defense
# Copy this file to .env and adjust variables as needed

# Application Settings
APP_NAME=VOICEGUARD AI
ENVIRONMENT=production
APP_ENV=production
DEBUG=false
PORT=8000

# Security & JWT Authentication (REQUIRED in production: 32+ character random secret)
SECRET_KEY=generate-a-strong-random-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Persistence
# For Render PostgreSQL: postgresql://user:password@hostname:5432/dbname
# For Persistent SQLite: sqlite:///./voiceguard.db
DATABASE_URL=sqlite:///./voiceguard.db

# Allowed CORS Origins (Include your Vercel deployment URL)
CORS_ORIGINS=https://voiceguard.vercel.app,http://localhost:3000,http://localhost:8000

# File Storage
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE_MB=25

# AI Model Integration Flags
AASIST_MODEL_ENABLED=true
RAWNET2_MODEL_ENABLED=true
ECAPA_MODEL_ENABLED=true

