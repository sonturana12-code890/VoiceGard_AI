# VOICEGUARD AI Backend Environment Configuration
# Problem Statement: SIH26104 — AI Voice Anti-Spoofing & Cyber Acoustic Defense
# Copy this file to .env or backend/.env and adjust variables as needed

# Application Settings
APP_NAME=VOICEGUARD AI Backend
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & JWT Authentication
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-voiceguard-secret-key-32bytes-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (SQLite with WAL mode)
DATABASE_URL=sqlite:///./voiceguard.db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Allowed CORS Origins (Frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# FFmpeg & FFprobe Executable Paths (Optional: auto-detected if omitted)
FFMPEG_PATH=C:\Users\LC\Downloads\ffmpeg-9.0.2-essentials_build\ffmpeg-9.0.2-essentials_build\bin\ffmpeg.exe
FFPROBE_PATH=C:\Users\LC\Downloads\ffmpeg-9.0.2-essentials_build\ffmpeg-9.0.2-essentials_build\bin\ffprobe.exe

# AI Model Integration Flags
# Checkpoints belong in backend/models_weights/ (aasist.onnx, rawnet2.onnx)
AASIST_MODEL_ENABLED=true
RAWNET2_MODEL_ENABLED=true
ECAPA_MODEL_ENABLED=true
